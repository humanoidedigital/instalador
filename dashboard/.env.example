# ============================================================
# Dashboard de Marketing — variáveis de ambiente
# Copie para .env e preencha. Nada aqui vai para o browser.
# ============================================================

# Porta do processo Next.js (o nginx faz o proxy para ela)
PORT=3333

# ------------------------------------------------------------
# Acesso
#
# As credenciais master NÃO ficam aqui. Elas são criadas no primeiro acesso
# ao painel (ou pelo instalador) e gravadas como hash em config/secrets.json.
# Para redefinir sem navegador:
#   node scripts/set-password.mjs "usuario" "nova-senha"
#
# Este arquivo continua valendo como valor inicial das integrações; o painel
# admin grava por cima, no cofre, e o cofre tem prioridade.
# ------------------------------------------------------------

# Tempo de cache das respostas das APIs externas, em segundos
CACHE_TTL_SECONDS=300

# Fuso usado para "hoje" e para os rótulos de data
DASHBOARD_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------
# Histórico (SQLite)
#
# Sem histórico, o relatório só mostra o que as APIs devolvem agora — sem
# comparação com meses antigos e sem base para projeção. A coleta diária grava
# os fatos aqui e o relatório passa a ler daqui quando o período já foi coletado.
# ------------------------------------------------------------
DATABASE_ENABLED=true
# Caminho absoluto. Vazio = <pasta do clients.json>/data/dashboard.db
DATABASE_PATH=

# auto = histórico quando cobre o período, APIs quando não cobre
# db   = só histórico  |  live = só APIs (comportamento antigo)
DATA_SOURCE_MODE=auto

# Quantos dias a coleta diária reprocessa. As plataformas revisam números
# retroativamente, então recoletar a última semana corrige o passado recente.
COLLECT_LOOKBACK_DAYS=7

# Token que o cron usa para chamar POST /api/collect
COLLECT_TOKEN=

# ------------------------------------------------------------
# Fonte dos dados de mídia paga: windsor | native | demo
#   windsor -> uma API key só, cobre Meta + Google (recomendado para começar)
#   native  -> Google Ads API + Meta Marketing API direto (sem intermediário)
#   demo    -> dados sintéticos, para testar o dashboard sem credenciais
# ------------------------------------------------------------
ADS_PROVIDER=windsor

# --- Windsor.ai ---
# API key em https://onboard.windsor.ai/ (Account -> API key)
WINDSOR_API_KEY=
# Envia o filtro de contas na própria query (mais rápido). Se sua conta Windsor
# não aceitar o parâmetro, deixe false: o filtro é aplicado localmente.
WINDSOR_SEND_ACCOUNT_FILTER=false

# --- Google Ads API (ADS_PROVIDER=native) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID da MCC (conta gestora), somente números
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# --- Meta Marketing API (ADS_PROVIDER=native) ---
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ------------------------------------------------------------
# Fonte dos dados de CRM: rdstation | gohighlevel | demo
# ------------------------------------------------------------
CRM_PROVIDER=rdstation

# --- RD Station CRM ---
# Token da conta: Configurações -> Integrações -> API (RD Station CRM).
# Cada conta de CRM tem o seu token.
#
# Uma conta só para tudo -> preencha apenas RD_CRM_TOKEN.
# Uma conta por cliente  -> crie uma variável por cliente e aponte o NOME dela
#                           no campo rdCrmTokenEnv do config/clients.json.
#                           O token nunca vai para o clients.json (ele é versionado).
RD_CRM_TOKEN=

RD_CRM_TOKEN_ISENTEI=
RD_CRM_TOKEN_ISENTOO=
RD_CRM_TOKEN_ISENTEJA=
RD_CRM_TOKEN_DURAN=
RD_CRM_TOKEN_MULTIMARMORE=
RD_CRM_TOKEN_DUA=
RD_CRM_TOKEN_UNIVERPLAST=
RD_CRM_TOKEN_NOVACHEF=

# v1 = crm.rdstation.com/api/v1 (token na query, o mais comum)
# v2 = api.rd.services/crm/v2 (Bearer token)
RD_CRM_API_VERSION=v1
RD_CRM_API_BASE=https://crm.rdstation.com/api/v1
RD_CRM_V2_API_BASE=https://api.rd.services/crm/v2
RD_CRM_PAGE_SIZE=200
RD_CRM_MAX_PAGES=30

# Etapas (separadas por vírgula) que contam como venda ganha, além do desfecho
# "ganho" do próprio RD — útil quando o time marca a venda movendo o card
RD_WON_STAGES=

# Campos personalizados da negociação usados para atribuição, quando existirem
RD_UTM_SOURCE_FIELD=utm_source
RD_UTM_CAMPAIGN_FIELD=utm_campaign

# ------------------------------------------------------------
# Análise por IA
#
# A chave é sua e a cobrança vai direto para a sua conta no provedor. Só
# agregados são enviados: nome, e-mail e telefone de lead nunca saem do
# servidor. Configurável também em Administração > Conexões > Análise por IA.
# ------------------------------------------------------------
# off | anthropic | openai | google
AI_PROVIDER=off

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Base alternativa (gateway corporativo, proxy). Vazio = API oficial.
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Base alternativa (Azure OpenAI, gateway). Vazio = https://api.openai.com/v1
OPENAI_BASE_URL=

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
GOOGLE_AI_BASE_URL=

# Contexto da agência que a IA deve considerar na análise
AI_EXTRA_CONTEXT=
# Mesmos números, mesma análise: não paga duas vezes. Padrão 6 h.
AI_CACHE_SECONDS=21600

# --- Alertas ---
# Webhook que recebe um POST por alerta novo (Slack, Discord, n8n).
# Vazio = os alertas ficam só no relatório e no histórico.
ALERT_WEBHOOK_URL=
# Janela padrão, em dias, para regras sem janela própria.
ALERT_WINDOW_DAYS=7

# --- GoHighLevel (alternativa, só com CRM_PROVIDER=gohighlevel) ---
GHL_API_TOKEN=
GHL_API_VERSION=2021-07-28
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_WON_STAGES=
