#!/bin/bash
#
# Instalador do DASHBOARD DE MARKETING (Google Ads + Meta Ads + CRM GoHighLevel).
#
# Pode rodar no mesmo VPS do whaticket: o dashboard sobe em processo próprio no
# PM2, com Node 20 dedicado em /opt/node20, sem tocar no node do sistema.
#
# Uso:  sudo ./install_dashboard

# reset shell colors
tput init

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  PROJECT_ROOT="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$PROJECT_ROOT/$SOURCE"
done
PROJECT_ROOT="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# required imports
source "${PROJECT_ROOT}"/variables/manifest.sh
source "${PROJECT_ROOT}"/utils/manifest.sh
source "${PROJECT_ROOT}"/lib/manifest.sh

# nome do processo no pm2, da pasta em /home/deploy e do site no nginx
dashboard_name=marketing-dashboard

#######################################
# garante as dependências de sistema sem reinstalar o que já existe
#######################################
dashboard_dependencies() {
  print_banner
  printf "${WHITE} 💻 Verificando dependências do sistema...${GRAY_LIGHT}"
  printf "\n\n"

  sleep 2

  sudo su - root <<EOF
  apt -y update
  apt install -y curl xz-utils rsync

  if ! command -v nginx >/dev/null; then
    apt install -y nginx
    rm -f /etc/nginx/sites-enabled/default
  fi

  if ! command -v certbot >/dev/null; then
    apt install -y snapd
    snap install core
    snap refresh core
    snap install --classic certbot
    ln -sf /snap/bin/certbot /usr/bin/certbot
  fi

  if ! id deploy >/dev/null 2>&1; then
    useradd -m -s /bin/bash -G sudo deploy
  fi
EOF

  sleep 2
}

#######################################
# cria swap em VPS pequena
#
# O `next build` chega a ~700 MB de pico e o `npm install` sobe mais que isso.
# Numa VPS de 2 GB sem swap o build morre com OOM no meio — e o sintoma
# (processo "Killed" sem explicação) não ajuda ninguém. Melhor prevenir.
#######################################
dashboard_swap_setup() {
  print_banner
  printf "${WHITE} 💻 Verificando memória e swap...${GRAY_LIGHT}"
  printf "\n\n"

  sleep 2

  sudo su - root <<'EOF'
  total_ram=$(free -m | awk '/^Mem:/ {print $2}')
  total_swap=$(free -m | awk '/^Swap:/ {print $2}')

  echo "RAM: ${total_ram} MB | Swap: ${total_swap} MB"

  if [ "${total_ram}" -lt 3500 ] && [ "${total_swap}" -lt 512 ]; then
    echo "Memória curta para compilar o dashboard — criando swap de 2 GB..."
    fallocate -l 2G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=2048
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    grep -q "^/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
    free -m | head -3
  fi
EOF

  sleep 2
}

#######################################
# confere se o domínio já aponta para este servidor
#
# O certbot falha quando o A record ainda não propagou, e o script seguiria
# adiante deixando o painel no ar sem HTTPS. Melhor parar e avisar.
#######################################
dashboard_dns_check() {
  print_banner
  printf "${WHITE} 💻 Conferindo o DNS do domínio...${GRAY_LIGHT}"
  printf "\n\n"

  dashboard_domain=$(echo "${dashboard_url/https:\/\//}")
  dashboard_domain=${dashboard_domain%%/*}

  server_ip=$(curl -s --max-time 10 https://api.ipify.org)
  [ -z "$server_ip" ] && server_ip=$(hostname -I | awk '{print $1}')
  domain_ip=$(getent hosts "$dashboard_domain" | awk '{print $1}' | head -1)

  printf "${WHITE}   Domínio:  ${dashboard_domain} -> ${domain_ip:-nao resolve}${GRAY_LIGHT}\n"
  printf "${WHITE}   Servidor: ${server_ip}${GRAY_LIGHT}\n\n"

  if [ "$domain_ip" != "$server_ip" ]; then
    printf "${WHITE} ⚠️  O domínio ainda não aponta para este servidor.${GRAY_LIGHT}\n"
    printf "${WHITE}    Crie um registro A de ${dashboard_domain} para ${server_ip} e espere propagar.${GRAY_LIGHT}\n\n"
    printf "${WHITE}    ENTER para tentar mesmo assim, ou CTRL+C para sair e ajustar o DNS.${GRAY_LIGHT}\n\n"
    read -p "> " _dns_confirm
  fi

  sleep 2
}

#######################################
# instala o pm2 caso ainda não exista no servidor
#######################################
dashboard_pm2_install() {
  print_banner
  printf "${WHITE} 💻 Verificando pm2...${GRAY_LIGHT}"
  printf "\n\n"

  sleep 2

  sudo su - root <<EOF
  if ! command -v pm2 >/dev/null; then
    /opt/node20/bin/npm install -g pm2
    ln -sf /opt/node20/bin/pm2 /usr/bin/pm2
  fi
  su - deploy -c "pm2 ping" >/dev/null 2>&1
  env PATH=\$PATH:/opt/node20/bin pm2 startup systemd -u deploy --hp /home/deploy
EOF

  sleep 2
}

# interactive CLI
inquiry_dashboard

# dependências
dashboard_dependencies
dashboard_swap_setup
dashboard_node20_install
dashboard_pm2_install

# aplicação
dashboard_copy_files
dashboard_set_env
dashboard_node_dependencies
dashboard_node_build
dashboard_start_pm2

# rede
dashboard_nginx_setup
dashboard_dns_check
dashboard_certbot_setup

dashboard_done
